# Noah's Pets — environment template (NAMES + placeholders only)
# Frontend → .env.local (VITE_* are public / build-time)
# Server → Vercel Project Settings → Environment Variables (never VITE_)
# Never commit real secrets.

# ---------------------------------------------------------------------------
# PUBLIC CLIENT (Vite / browser)
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://your-domain.example

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Razorpay Checkout Key ID only (NOT the secret)
VITE_PAYMENT_PROVIDER=razorpay
VITE_RAZORPAY_KEY_ID=
VITE_PAYMENT_CREATE_ORDER_URL=/api/payments/razorpay/create-order
VITE_PAYMENT_VERIFY_URL=/api/payments/razorpay/verify
VITE_PAYMENT_STATUS_URL=/api/payments/razorpay/status
VITE_PAYMENT_PENDING_ORDER_URL=/api/orders/pending

# Optional
# VITE_GA_MEASUREMENT_ID=
# VITE_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# SERVER ONLY (Vercel Environment Variables — Production + Preview)
# Never prefix these with VITE_
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Paste the private key with \n for newlines, or use FIREBASE_SERVICE_ACCOUNT_JSON=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: same as VITE_FIREBASE_API_KEY (public web key for REST fallback)
FIREBASE_WEB_API_KEY=

# Optional CORS extras (comma-separated). Same-origin Vercel usually needs none.
# CORS_ORIGINS=https://your-custom-domain.com
# ADMIN_EMAIL=noahspets99@gmail.com

# Local payments:dev only (never set on Vercel):
# PAYMENTS_STORE=memory
# PAYMENTS_PORT=8787
