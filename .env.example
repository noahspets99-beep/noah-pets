# Noah's Pets — environment template
# Copy to .env.local and fill in values. Never commit secrets.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
VITE_SITE_URL=https://noahspets.com

# Firebase web app config (Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=noah-47396.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=noah-47396
VITE_FIREBASE_STORAGE_BUCKET=noah-47396.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Payment provider: demo | razorpay
VITE_PAYMENT_PROVIDER=demo

# When using Razorpay, point these to YOUR secure backend endpoints.
# Never put Razorpay key_secret in the frontend.
# VITE_PAYMENT_CREATE_ORDER_URL=https://api.yourdomain.com/payments/razorpay/create-order
# VITE_PAYMENT_VERIFY_URL=https://api.yourdomain.com/payments/razorpay/verify

# Optional analytics / Search Console (also manageable in Admin → SEO)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# VITE_GOOGLE_SITE_VERIFICATION=
