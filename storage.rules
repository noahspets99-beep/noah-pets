rules_version = '2';

service firebase.storage {
  match /b/b/{bucket}/o {
    function isAdminByEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'noahspets99@gmail.com';
    }

    function isAdminByDoc() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isAdminByEmail() || isAdminByDoc();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /store/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
